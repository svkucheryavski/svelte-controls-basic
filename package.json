      "NEWS.md"
   ],
   "sideEffects": [
      "**/*.css"
   ],
   "repository": {
      "type": "git",
      "url": "git+https://github.com/svkucheryavski/svelte-controls-basic.git"
   },
   "homepage": "https://github.com/svkucheryavski/svelte-controls-basic#readme",
   "bugs": {
      "url": "https://github.com/svkucheryavski/svelte-controls-basic/issues"
