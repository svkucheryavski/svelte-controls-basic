{
   "name": "svelte-controls-basic",
   "description": "Svelte components for creating simple control widgets",
   "version": "3.0.0",
   "author": "Sergey Kucheryavskiy",
   "license": "MIT",
   "private": false,
   "type": "module",
   "svelte": "./src/controls/index.js",
   "exports": {
      ".": {
         "svelte": "./src/controls/index.js",
